# ─────────────────────────────────────────────────────────────
# Eventis Bot — configuration locale
# Copie ce fichier en « .env » (cp .env.example .env) puis remplis-le.
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────

# Portail développeur Discord → ton application → Bot → Reset Token.
# Ne colle jamais ce token dans une conversation, un ticket ou un commit.
DISCORD_BOT_TOKEN=

# Portail développeur → General Information → Application ID.
DISCORD_CLIENT_ID=

# Clic droit sur le serveur EventisPro → Copier l'identifiant du serveur (mode développeur activé).
DISCORD_GUILD_ID=

# Salons (clic droit → Copier l'identifiant du salon).
DISCORD_TICKET_CHANNEL_ID=        # 🎫・ouvrir-un-ticket
DISCORD_UPDATES_CHANNEL_ID=       # 🔄・updates
DISCORD_SALES_CHANNEL_ID=         # 📈・sales-feed
DISCORD_WELCOME_CHANNEL_ID=       # arrivant

# @Owner mentionné dans le ticket : renseigne UN SEUL des deux.
DISCORD_OWNER_ROLE_ID=
DISCORD_OWNER_USER_ID=

# Rôle de l'équipe support ajoutée aux tickets (facultatif).
DISCORD_SUPPORT_ROLE_ID=

# ── Intégration Eventis (réception des événements du site) ──
# LAISSE VIDE tant que le site Eventis n'est pas connecté au bot :
# tickets, bienvenue et /update-announce fonctionnent sans.
# Plus tard : secret partagé avec le site (64 caractères), généré dans un terminal avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVENTIS_WEBHOOK_SECRET=
# Ancien secret accepté pendant une rotation (facultatif).
EVENTIS_WEBHOOK_SECRET_PREVIOUS=
# 127.0.0.1 = API accessible uniquement depuis cette machine (recommandé tant que le site n'est pas connecté).
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# true uniquement derrière un reverse proxy (Caddy, Nginx…) qui renseigne X-Forwarded-For.
WEBHOOK_TRUST_PROXY=false

# ── Sales-feed ──
# Reste à false tant que les paiements réels ne sont pas activés sur Eventis
# ET que tu n'as pas autorisé les annonces de ventes.
SALES_FEED_ENABLED=false
# Lien du titre « New Sale On Eventis » si l'événement n'a pas d'URL publique (facultatif).
EVENTIS_MARKETPLACE_URL=

# ── Updates ──
# Miniature du logo EventisPro en haut à droite de l'annonce (comme la capture).
UPDATES_SHOW_LOGO=true

# ── Tickets ──
TICKET_COOLDOWN_SECONDS=60
TICKET_MAX_STAFF_ADDED=25

# ── Bienvenue ──
# Pas de nouveau message si le même membre revient dans ce délai (anti-spam).
WELCOME_REJOIN_COOLDOWN_HOURS=24

# ── Divers ──
DATABASE_PATH=./data/eventis-bot.sqlite
TIMEZONE=Europe/Paris
LOG_LEVEL=info
