{
  "name": "eventis-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Eventis Bot — bot Discord officiel de la communauté EventisPro",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "check-config": "tsx --disable-warning=ExperimentalWarning src/scripts/check-config.ts",
    "register-commands": "tsx --disable-warning=ExperimentalWarning src/scripts/register-commands.ts",
    "previews": "tsx --disable-warning=ExperimentalWarning src/scripts/render-previews.ts",
    "sign-event": "tsx --disable-warning=ExperimentalWarning src/scripts/sign-event.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
